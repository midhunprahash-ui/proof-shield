# Add real values only to .env. Never commit .env or live credentials.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

PROOFSHIELD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local document extraction. JSON/text stays deterministic. PDF/image OCR uses
# PP-OCRv6 locally; no evidence bytes are sent to a separate OCR cloud.
# A future cloud adapter can implement the same server-side provider contract.
PROOFSHIELD_OCR_PROVIDER=paddle
PROOFSHIELD_OCR_MIN_CONFIDENCE=0.5
PROOFSHIELD_OCR_MAX_PAGES=10

# Backend-only Supabase configuration. Never expose the secret/service-role key
# to a browser, frontend bundle, log, screenshot, or public repository.
SUPABASE_PROJECT_REF=qoujhmqkjicvcwoiyqkp
SUPABASE_URL=https://qoujhmqkjicvcwoiyqkp.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Browser-safe key used only to start Supabase Auth sessions. The backend
# returns it through /v1/auth/config; never substitute the secret key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_EVIDENCE_BUCKET=proofshield-evidence

# The AI provider is intentionally not required for Milestone 1.
LLM_API_KEY=replace_me_later
